{
  "name": "bunker-9",
  "version": "2.0.0",
  "description": "BUNKER·9 — social deduction game for 5–15 players (Bun + Datastar)",
  "private": true,
  "scripts": {
    "start": "bun run server.ts",
    "dev": "bun --watch run server.ts",
    "check": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "verify": "bun tools/verify.mjs",
    "test": "bun test/sim-bun.mjs",
    "test:15": "BOTS=15 bun test/sim-bun.mjs",
    "build": "bun build ./server.ts --compile --bytecode --target=bun-linux-x64 --outfile dist/bunker9",
    "build:local": "bun build ./server.ts --compile --bytecode --outfile dist/bunker9-local",
    "start:bin": "./dist/bunker9",
    "test:http": "bun tools/http-e2e.mjs",
    "test:ui": "bun tools/ui-e2e.mjs",
    "shots": "bun tools/shot-redesign.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
